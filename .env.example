# WooCommerce REST API Integration
# Copy this file to .env.local and fill in your values.
# See: https://woocommerce.github.io/woocommerce-rest-api-docs/

# Base URL of the WooCommerce store (safe to expose — no credentials here).
# Local dev: your ngrok forwarding URL. Note: ngrok free-tier URLs rotate
# on every restart — update this whenever the tunnel restarts.
NEXT_PUBLIC_WC_URL=https://your-store-url.example.com

# WooCommerce REST API keys (WP Admin → WooCommerce → Settings → Advanced → REST API).
# Server-only — never prefix with NEXT_PUBLIC_, never referenced from client code.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_USE_MOCK_DATA=true

# Accounts — native WooCommerce customers, authenticated via a JWT plugin
# installed on the WordPress backend (e.g. "JWT Authentication for WP-API").
# Registration itself uses the WC_CONSUMER_KEY/SECRET above; this endpoint
# is only hit at login, to verify a customer's own password.
#
# SESSION_SECRET encrypts this app's own session cookie (iron-session) —
# 32+ random characters, e.g. `openssl rand -base64 32`. Keep it stable in
# production or every signed-in session invalidates on rotation.
SESSION_SECRET=

# Payments — Stripe, test mode to start.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe-webhook idempotency only (Upstash for Redis via the Vercel
# Marketplace — that product injects KV_REST_API_URL/TOKEN, not the generic
# UPSTASH_REDIS_REST_* names).
KV_REST_API_URL=
KV_REST_API_TOKEN=
