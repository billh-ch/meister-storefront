# WooCommerce REST API Integration
# Copy this file to .env.local and fill in your values.
# See: https://woocommerce.github.io/woocommerce-rest-api-docs/

# Base URL of the WooCommerce store (safe to expose — no credentials here).
# Local dev: your ngrok forwarding URL. Note: ngrok free-tier URLs rotate
# on every restart — update this whenever the tunnel restarts.
NEXT_PUBLIC_WC_URL=https://your-store-url.example.com

# WooCommerce REST API keys (WP Admin → WooCommerce → Settings → Advanced → REST API).
# Server-only — never prefix with NEXT_PUBLIC_, never referenced from client code.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_USE_MOCK_DATA=true
