{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meister-storefront-test",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "workers_dev": true,
  "upload_source_maps": false,
  "preview_urls": true,
  "vars": {
    "VERCEL_ENV": "preview",
    "NEXT_PUBLIC_USE_MOCK_DATA": "true",
    "PRERENDER_PRODUCTS": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
