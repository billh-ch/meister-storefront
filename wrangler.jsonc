{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meister-storefront-test",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/optimized/*",
      "!/images/*"
    ]
  },
  "workers_dev": true,
  "upload_source_maps": false,
  "preview_urls": true,
  "kv_namespaces": [{ "binding": "VINEXT_KV_CACHE", "id": "0140aec8011f44d7915a23eec1c7154f" }],
  "vars": {
    "VERCEL_ENV": "preview",
    "NEXT_PUBLIC_USE_MOCK_DATA": "false",
    "NEXT_PUBLIC_WC_URL": "https://rpiwordpress.kudu-ulmer.ts.net:8443",
    "NEXT_PUBLIC_SITE_URL": "https://meister-storefront-test.hbill5488.workers.dev",
    "STRIPE_CHECKOUT_ORIGIN": "https://meister-storefront-test.hbill5488.workers.dev",
    "STRIPE_EXPECTED_MODE": "test",
    "CHECKOUT_PAYMENTS_ENABLED": "false",
    "PRERENDER_PRODUCTS": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
