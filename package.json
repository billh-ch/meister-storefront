{
  "name": "meister-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-images.mjs && next dev",
    "build": "node scripts/prepare-images.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "test:seo": "node tests/seo.browser.mjs",
    "test:browser": "node tests/shopping.browser.mjs && node tests/checkout.browser.mjs && node tests/cart-options.browser.mjs && node tests/cart-recommendations.browser.mjs && node tests/mobile-variants.browser.mjs && node tests/cart-flow.browser.mjs && node tests/product-card-gallery.browser.mjs && node tests/wishlist.browser.mjs && node tests/compare.browser.mjs",
    "test:cache": "node tests/cache.browser.mjs",
    "test:checkout-live": "node tests/checkout-live.browser.mjs",
    "test:agents": "node tests/agents.browser.mjs",
    "dev:vinext": "node scripts/prepare-images.mjs && vite dev --port 3001",
    "build:vinext": "node scripts/prepare-images.mjs && vite build",
    "images:refresh": "node scripts/prepare-images.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@upstash/redis": "^1.38.2",
    "@vinext/cloudflare": "1.2.1",
    "embla-carousel-react": "^8.6.0",
    "entities": "^7.0.1",
    "htmlparser2": "10.1.0",
    "iron-session": "^8.0.4",
    "next": "16.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.5.0",
    "vinext": "1.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "1.58.2",
    "postcss": "8.5.32",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vite-css-modules": "1.16.1",
    "wrangler": "4.153.0"
  },
  "type": "module"
}
